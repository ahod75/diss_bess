# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Ignore everything in the raw data folder
data/raw/*
# EXCEPT the .gitkeep file
!data/raw/.gitkeep

# Ignore everything in the processed data folder
data/processed/*
# EXCEPT the .gitkeep file
!data/processed/.gitkeep

# Ignore other raw dataset folders
data/unisolar_data/
data/wpd_comp_data_2021/